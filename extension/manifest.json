{
  "manifest_version": 3,
  "name": "GeminiForge",
  "version": "1.1.0",
  "default_locale": "en",
  "description": "__MSG_description__",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:18765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["languages.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
